# Copy to .env (never commit .env). All settings are read at startup.

# Required. For Neon, use the DIRECT (non-pooled) connection string: this
# server keeps its own pool and sets session options (UTC, statement timeout).
KITCHEN_DATABASE_URL=postgresql://user:pass@localhost:5432/kitchen

# Required for R1: the one household this server serves (until OAuth, FR-23).
KITCHEN_HOUSEHOLD_ID=demo

# Required unless KITCHEN_ALLOW_NO_AUTH=1. At least 32 characters.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
KITCHEN_AUTH_TOKEN=
# KITCHEN_ALLOW_NO_AUTH=1   # local development only

# Network. Use 0.0.0.0 inside a container. PORT is also honored.
KITCHEN_HOST=127.0.0.1
KITCHEN_PORT=8000

# When public (not localhost), list your hostname to keep DNS-rebinding
# protection on, e.g. sous-chef.example.com
# KITCHEN_ALLOWED_HOSTS=
# KITCHEN_ALLOWED_ORIGINS=

# Tuning (defaults shown)
# KITCHEN_DB_POOL_MAX=5
# KITCHEN_DB_ACQUIRE_TIMEOUT_S=2.5
# KITCHEN_DB_STATEMENT_TIMEOUT_MS=3000
# KITCHEN_TOOL_TIMEOUT_S=8
# KITCHEN_LOG_LEVEL=INFO
